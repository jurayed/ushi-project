# ==================== DATABASE ====================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ushi
DB_USER=postgres
DB_PASSWORD=your_password_here

# ==================== REDIS (опционально) ====================
# Если не задано — используется in-memory fallback (только для разработки).
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ==================== SERVER ====================
PORT=3000
# Origin разрешённый CORS (в проде укажи конкретный домен вместо *)
CORS_ORIGIN=*
# Обязательно замени на длинный случайный секрет
JWT_SECRET=change_me_to_a_very_long_random_string_please

# ==================== LOCAL AI: OLLAMA (LLM) ====================
# Адрес Ollama-сервера. Если бэкенд и Ollama на одной машине — оставь так.
OLLAMA_URL=http://127.0.0.1:11434
# Модель по-умолчанию. Для RU+UZ рекомендую gemma3:27b или gemma3:12b для слабых машин.
OLLAMA_DEFAULT_MODEL=gemma3:27b

# ==================== LOCAL STT: faster-whisper-server ====================
# OpenAI-совместимый HTTP сервер распознавания.
WHISPER_URL=http://127.0.0.1:8000
WHISPER_MODEL=large-v3
# Пусто = автодетект языка (медленнее, но работает для RU/UZ/EN).
# Или форсируй 'ru' / 'uz' / 'en'.
WHISPER_DEFAULT_LANG=

# ==================== LOCAL TTS ====================
# Движок: piper (по-умолчанию) или openai-compatible (для XTTS/Coqui).
TTS_ENGINE=piper
TTS_URL=http://127.0.0.1:5000

# Голоса по языкам. Для Piper — имена из rhasspy/piper-voices:
#   Русский:    ru_RU-irina-medium / ru_RU-dmitri-medium / ru_RU-denis-medium
#   Узбекский:  нет нативного Piper-голоса — используем Турецкий (фонетически близкий)
#               tr_TR-dfki-medium / tr_TR-fettah-medium
#   Английский: en_US-lessac-medium / en_US-amy-medium
TTS_VOICE_RU=ru_RU-irina-medium
TTS_VOICE_UZ=tr_TR-dfki-medium
TTS_VOICE_EN=en_US-lessac-medium
